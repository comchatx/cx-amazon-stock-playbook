    mk, interval, gran = q("marketplaceIds"), q("interval"), q("granularity")
    if not mk or not interval or not gran:
        err(400, "InvalidInput", "marketplaceIds, interval and granularity are required.")
    mkt_ok(mk)
    if mk != "ATVPDKIKX0DER":
        reply(200, {"payload": []})
    if gran not in ("Day", "Week", "Month", "Total"):
        err(400, "InvalidInput", "stub: granularity %s has no fixture; Day, Week, Month and Total do" % gran)
    if q("sku") and q("asin"):
        err(400, "InvalidInput", "Either asin or sku may be given, not both.")
    data = latest("orderMetrics-daily.json")
    try:
        a, b_ = interval.split("--")
        d0, d1 = dt.date.fromisoformat(a[:10]), dt.date.fromisoformat(b_[:10])
    except ValueError:
        err(400, "InvalidInput", "interval is start--end in ISO 8601.")
    off = a[19:] or "Z"
    first = dt.date.fromisoformat(data["start"])
    skus = [s for s in data["units"] if (not q("sku") or s == q("sku")) and (not q("asin") or data["asin"][s] == q("asin"))]
    if q("fulfillmentNetwork") == "MFN":
        skus = []
    days, d = [], d0
    while d < d1:
        days.append(d)
        d += dt.timedelta(1)
    def units(day):
        i = (day - first).days
        return [(s, data["units"][s][i]) for s in skus if 0 <= i < len(data["units"][s])]
    def key(day):
        return {"Day": day, "Week": day - dt.timedelta((day - d0).days % 7), "Month": day.replace(day=1), "Total": d0}[gran]
    buckets, order = {}, []
    for day in days:
        k = key(day)
        if k not in buckets:
            buckets[k] = [0, 0.0, 0]
            order.append(k)
        for s, u in units(day):
            buckets[k][0] += u
            buckets[k][1] += u * data["price"][s]
            buckets[k][2] += u and 1
    res = []
    for i, k in enumerate(order):
        e = order[i + 1] if i + 1 < len(order) else d1
        u, sales, n = buckets[k]
        res.append({"interval": "%sT00:00:00%s--%sT00:00:00%s" % (k.isoformat(), off, e.isoformat(), off if i + 1 < len(order) else (b_[19:] or off)), "unitCount": u,
                    "orderItemCount": u, "orderCount": u, "averageUnitPrice": {"amount": "%.2f" % (sales / u if u else 0), "currencyCode": "USD"},
                    "totalSales": {"amount": "%.2f" % sales, "currencyCode": "USD"}})
    reply(200, {"payload": res})

# ---- Multi-Channel Fulfillment previews (reads; createOrder and the rest are refused above)
def fulfillable(sku, mk="ATVPDKIKX0DER"):
    doc = latest("getInventorySummaries-%s.json" % mk) or {"payload": {"inventorySummaries": []}}
    for r in doc["payload"]["inventorySummaries"]:
        if r["sellerSku"] == sku:
            return r["inventoryDetails"]["fulfillableQuantity"]
    return None

if path == "/fba/outbound/2020-07-01/fulfillmentOrders/preview":
    b = body()
    if not b.get("address") or not b.get("items"):
        err(400, "InvalidInput", "address and items are required.")
    mk = b.get("marketplaceId") or "ATVPDKIKX0DER"
    mkt_ok(mk)
    fees = latest("mcf-fees.json") or {}
    unf, ok_items, total_units = [], [], 0
    for it in b["items"]:
        have = fulfillable(it.get("sellerSku"), mk)
        qty = int(it.get("quantity") or 0)
        total_units += qty
        if have is None:
            unf.append({"sellerSku": it.get("sellerSku"), "quantity": qty, "sellerFulfillmentOrderItemId": it.get("sellerFulfillmentOrderItemId"),
                        "itemUnfulfillableReasons": ["InvalidSKU"]})
        elif have < qty:
            unf.append({"sellerSku": it["sellerSku"], "quantity": qty - have, "sellerFulfillmentOrderItemId": it.get("sellerFulfillmentOrderItemId"),
                        "itemUnfulfillableReasons": ["InventoryUnavailable"]})
            ok_items.append((it, have))
        else:
            ok_items.append((it, qty))
    speeds = b.get("shippingSpeedCategories") or ["Standard", "Expedited", "Priority"]
    previews = []
    for sp in speeds:
        est = []
        for it, n in ok_items:
            f = fees.get(it["sellerSku"], {})
            for name, amt in f.items():
                v = amt * (n if "PerUnit" in name else 1) * {"Standard": 1, "Expedited": 1.6, "Priority": 2.3, "ScheduledDelivery": 2.3}.get(sp, 1)
                est.append({"name": name, "amount": {"currencyCode": "USD", "value": "%.2f" % v}})
        previews.append({"shippingSpeedCategory": sp, "isFulfillable": not unf, "isCODCapable": False, "marketplaceId": mk,
                         "estimatedFees": est, "unfulfillablePreviewItems": unf,
                         "orderUnfulfillableReasons": ["InventoryUnavailable"] if unf else [],
                         "fulfillmentPreviewShipments": [] if unf else [{"earliestShipDate": "2026-11-11T08:00:00Z", "latestShipDate": "2026-11-11T08:00:00Z",
                             "fulfillmentPreviewItems": [{"sellerSku": it["sellerSku"], "quantity": n, "sellerFulfillmentOrderItemId": it.get("sellerFulfillmentOrderItemId")} for it, n in ok_items]}]})
    reply(200, {"payload": {"fulfillmentPreviews": previews}})

